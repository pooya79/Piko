APP_ENV=development
HTTP_ADDR=:8080
# Server, worker, and migrations must use the same local file.
DATABASE_PATH=./data/piko.db
# Generate a unique value of at least 32 characters for every environment.
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=http://localhost:8080
SMTP_ADDR=localhost:1025
SMTP_FROM=piko@localhost.test
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=false
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
LOG_LEVEL=info
TRUSTED_PROXY=false
COOKIE_SECURE=false
