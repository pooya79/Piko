APP_ENV=development
HTTP_ADDR=:8080
# Server and migrations must use the same local file.
DATABASE_PATH=./data/piko.db
# Generate a unique value of at least 32 characters for every environment.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Separate credential encryption key: generate with `openssl rand -base64 32`.
# Required in all environments. Keep it stable and back it up securely.
BOT_ENCRYPTION_KEY=
# Production HTTPS origin, e.g. https://bots.example.com (no path/query).
# Empty in development selects polling; use separate development bots/databases.
# Changing this requires explicit activation again for Bots saved in another mode.
BOT_PUBLIC_URL=
LOG_LEVEL=info
TRUSTED_PROXY=false
COOKIE_SECURE=false
