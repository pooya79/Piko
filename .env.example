APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://buildx:buildx@localhost:5432/buildx?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# If defaults conflict locally, set POSTGRES_PORT/REDIS_PORT and update the URLs.
POSTGRES_PORT=5432
REDIS_PORT=6379
# Generate a unique value of at least 32 characters for every environment.
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=http://localhost:8080
SMTP_ADDR=localhost:1025
SMTP_FROM=buildx@localhost.test
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=false
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
LOG_LEVEL=info
TRUSTED_PROXY=false
COOKIE_SECURE=false
