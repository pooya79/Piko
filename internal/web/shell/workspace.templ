package shell

import (
 "github.com/pooya79/Piko/internal/locale"
 "github.com/pooya79/Piko/internal/web/head"
)

// Workspace keeps navigation and account access separate from feature content.
templ Workspace(displayName, csrf string, page Page, content templ.Component) {
 {{ page = page.withDefaults(ctx) }}
 <!doctype html>
 <html lang="fa" dir="rtl" data-theme="piko-light">
  <head>
   @head.Head(page.Title)
   <script src="/static/dashboard.js" defer></script>
  </head>
  <body class="piko-workspace-body antialiased">
   @head.SkipLink()
   <div class="piko-workspace">
    <dialog open id="workspace-navigation" class="piko-navigation" aria-labelledby="navigation-title">
     @sidebar(displayName, csrf, page)
    </dialog>
    <div class="piko-workspace-main">
     @topbar(page)
     <main id="main-content" tabindex="-1" class="piko-dashboard-main">
      if page.BotURL != "" {
       @botNavigation(page)
      }
      @content
      <footer class="piko-workspace-footer"><span>{ locale.T(ctx, "workspace.footer.brand") }</span><span>{ locale.T(ctx, "workspace.footer.purpose") }</span></footer>
     </main>
    </div>
   </div>
  </body>
 </html>
}

templ botNavigation(page Page) {
 <nav class="piko-bot-navigation" aria-label={ locale.T(ctx, "bot.navigation") }>
  @botNavigationLink(page, BotOverview, "bot.overview.title", "")
  @botNavigationLink(page, BotStudio, "bot.studio.title", "/studio")
  @botNavigationLink(page, BotSubmissions, "submission.title", "/submissions")
  @botNavigationLink(page, BotConnection, "bot.connection.title", "/connection")
  @botNavigationLink(page, BotSettings, "bot.settings.title", "/settings")
  @botNavigationLink(page, BotDraft, "draft.title", "/draft")
 </nav>
}

templ botNavigationLink(page Page, section BotNavSection, key, suffix string) {
 <a href={ templ.URL(page.BotURL+suffix) }
  if page.BotSection == section {
   aria-current="page"
  }
 >{ locale.T(ctx, key) }</a>
}

templ Icon(name string) {
 <svg class="piko-icon" aria-hidden="true"><use href={ "/static/icons.svg#" + name }></use></svg>
}

// Future actions never submit or navigate. Their availability is visible in the label.
templ ComingSoon(label, icon, class string) {
 <button type="button" disabled class={ "piko-coming-soon " + class }>
  @Icon(icon)<span>{ label }</span><small>{ locale.T(ctx, "workspace.soon") }</small>
 </button>
}

templ sidebar(displayName, csrf string, page Page) {
 <aside class="piko-sidebar" aria-label={ locale.T(ctx, "workspace.navigation") }>
  <div class="piko-drawer-heading"><h2 id="navigation-title">{ locale.T(ctx, "workspace.navigation") }</h2><button type="button" class="piko-drawer-close" data-navigation-close autofocus>{ locale.T(ctx, "workspace.navigation.close") }</button></div>
  <a class="piko-workspace-brand" href="/dashboard"><img src="/static/brand/piko-mark-v2.webp" width="44" height="44" alt=""/><span>پیکو<small>{ locale.T(ctx, "workspace.brand.tagline") }</small></span><span class="piko-latin-brand" lang="en" dir="ltr">piko</span></a>
  <a class="piko-workspace-identity" href="/account">@Icon("user")<div><bdi dir="auto">{ displayName }</bdi><small>{ locale.T(ctx, "workspace.personal") }</small></div>@Icon("caret-left")</a>
  <nav aria-label={ locale.T(ctx, "workspace.navigation") }>
   <p class="piko-sidebar-label">{ locale.T(ctx, "workspace.title") }</p>
   @navigationLink(locale.T(ctx, "dashboard.title"), "house", "/dashboard", page.ActiveNav == DashboardNav)
   if page.BuilderURL != "" {
    @navigationLink(locale.T(ctx, "workspace.chat"), "chat-circle-dots", page.BuilderURL, page.ActiveNav == BuilderNav)
   } else {
    @ComingSoon(locale.T(ctx, "workspace.chat"), "chat-circle-dots", "piko-nav-item")
   }
   if page.BotsURL != "" {
    @navigationLink(locale.T(ctx, "workspace.bots"), "squares-four", page.BotsURL, page.ActiveNav == BotsNav)
   } else {
    @ComingSoon(locale.T(ctx, "workspace.bots"), "squares-four", "piko-nav-item")
   }
   @ComingSoon(locale.T(ctx, "workspace.analytics"), "chart-line-up", "piko-nav-item")
   @ComingSoon(locale.T(ctx, "workspace.billing"), "credit-card", "piko-nav-item")
  </nav>
  <section class="piko-sidebar-recent" aria-labelledby="recent-bots-title">
   <div class="piko-sidebar-label"><h2 id="recent-bots-title">{ locale.T(ctx, "workspace.recent") }</h2>@Icon("plus")</div>
   if len(page.RecentBots) == 0 {
    <p class="piko-sidebar-empty">{ locale.T(ctx, "dashboard.bots.empty") }</p>
   } else {
    for _, bot := range page.RecentBots {
     if bot.URL != "" {
      <a class="piko-nav-item" href={ templ.URL(bot.URL) }>@Icon("robot")<bdi dir="auto">{ bot.Name }</bdi></a>
     } else {
      <p class="piko-sidebar-empty"><bdi dir="auto">{ bot.Name }</bdi></p>
     }
    }
   }
  </section>
  <div class="piko-sidebar-bottom">
   <section class="piko-upgrade-card">
    @Icon("sparkle")<h2>{ locale.T(ctx, "workspace.plans.heading") }</h2><p>{ locale.T(ctx, "workspace.plans.copy") }</p>
    @ComingSoon(locale.T(ctx, "workspace.plans.action"), "arrow-right", "piko-secondary-action")
   </section>
   @ComingSoon(locale.T(ctx, "workspace.help"), "question", "piko-help-link")
   <div class="piko-sidebar-account">
    <a href="/account" class="piko-account-link">@Icon("user")<div><bdi dir="auto">{ displayName }</bdi><small>{ locale.T(ctx, "auth.account.heading") }</small></div></a>
    <form action="/logout" method="post"><input type="hidden" name="csrf_token" value={ csrf }/><button type="submit" class="piko-logout" aria-label={ locale.T(ctx, "auth.logout") }>@Icon("sign-out")</button></form>
   </div>
  </div>
 </aside>
}

templ navigationLink(label, icon, url string, active bool) {
 <a class={ "piko-nav-item", templ.KV("piko-nav-active", active) } href={ templ.URL(url) }
  if active {
   aria-current="page"
  }
 >@Icon(icon)<span>{ label }</span></a>
}

templ topbar(page Page) {
 <header class="piko-topbar">
  <div class="piko-topbar-navigation">
   <button type="button" class="piko-menu-trigger" data-navigation-open aria-controls="workspace-navigation" aria-haspopup="dialog" aria-expanded="false" aria-label={ locale.T(ctx, "workspace.navigation.open") }>{ locale.T(ctx, "workspace.navigation.menu") }</button>
   <nav class="piko-breadcrumb" aria-label={ locale.T(ctx, "workspace.breadcrumb") }>
    for i, crumb := range page.Breadcrumbs {
     if i > 0 {
      @Icon("caret-left")
     }
     if i == len(page.Breadcrumbs)-1 {
      <strong aria-current="page"><bdi dir="auto">{ crumb.Label }</bdi></strong>
     } else if crumb.URL != "" {
      <a href={ templ.URL(crumb.URL) }><bdi dir="auto">{ crumb.Label }</bdi></a>
     } else {
      <span><bdi dir="auto">{ crumb.Label }</bdi></span>
     }
    }
   </nav>
  </div>
  <div class="piko-header-actions">
   @themeChoices()
   <div class="piko-notifications">
    <button type="button" popovertarget="workspace-notifications" aria-controls="workspace-notifications" aria-expanded="false" aria-label={ locale.T(ctx, "workspace.notifications") }>@Icon("bell")</button>
    <section id="workspace-notifications" popover="auto" class="piko-notification-panel" aria-labelledby="notifications-title">
     <div class="piko-notification-heading"><h2 id="notifications-title">{ locale.T(ctx, "workspace.notifications") }</h2><button type="button" popovertarget="workspace-notifications" popovertargetaction="hide" autofocus aria-label={ locale.T(ctx, "workspace.notifications.close") }>{ locale.T(ctx, "workspace.close") }</button></div>
     <p>{ locale.T(ctx, "workspace.notifications.empty") }</p>
    </section>
   </div>
   if page.CreateBotURL != "" {
    <a class="piko-primary-action" href={ templ.URL(page.CreateBotURL) }>@Icon("plus")<span>{ locale.T(ctx, "bot.create.title") }</span></a>
   } else {
    @ComingSoon(locale.T(ctx, "workspace.create"), "plus", "piko-primary-action")
   }
  </div>
 </header>
}
