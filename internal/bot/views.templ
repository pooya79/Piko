package bot

import (
 "strconv"
 "github.com/pooya79/Piko/internal/locale"
 "github.com/pooya79/Piko/internal/web/shell"
)

templ ListPage(displayName, csrf string, bots []Bot) {
 @shell.Workspace(displayName, csrf, page(locale.T(ctx, "workspace.bots")), listContent(bots))
}

templ listContent(bots []Bot) {
 <div class="piko-section-heading"><h1 class="piko-page-title">{ locale.T(ctx, "workspace.bots") }</h1><a class="piko-primary-action" href="/bots/connect">@shell.Icon("plus")<span>{ locale.T(ctx, "bot.connect.title") }</span></a></div>
 if len(bots) == 0 {
  <section class="piko-card piko-bot-empty"><span class="piko-empty-icon">@shell.Icon("robot")</span><h2>{ locale.T(ctx, "dashboard.bots.empty") }</h2><p class="piko-page-copy">{ locale.T(ctx, "bot.list.empty") }</p><a class="piko-text-link" href="/bots/connect">{ locale.T(ctx, "bot.connect.first") }</a></section>
 } else {
  <p class="piko-page-copy">{ locale.T(ctx, "bot.list.copy") }</p>
  @Cards(bots)
 }
}

templ Cards(bots []Bot) {
 <div class="piko-bot-grid">
  for _, bot := range bots {
   <article class="piko-card piko-bot-card"><span class="piko-empty-icon">@shell.Icon("robot")</span><h2><a href={ templ.URL(bot.URL()) }><bdi dir="auto">{ bot.Name }</bdi></a></h2><p><bdi dir="ltr">{ "@" + bot.Username }</bdi></p><p class="piko-bot-status">@shell.Icon("check-circle")<span>{ locale.T(ctx, "bot.status.verified") }</span></p><p class="piko-helper">{ locale.T(ctx, "delivery.state."+bot.DeliveryState) }</p><a class="piko-text-link" href={ templ.URL(bot.URL()) }>{ locale.T(ctx, "bot.detail.link") }</a></article>
  }
 </div>
}

templ ConnectPage(displayName, csrf, message string, invalid bool) {
 @shell.Workspace(displayName, csrf, shell.Page{Title: locale.T(ctx, "bot.connect.title"), ActiveNav: shell.BotsNav, Breadcrumbs: []shell.Breadcrumb{{Label: locale.T(ctx, "workspace.bots"), URL: "/bots"}, {Label: locale.T(ctx, "bot.connect.title")}}}, connectContent(csrf, message, invalid))
}

templ connectContent(csrf, message string, invalid bool) {
 <h1 class="piko-page-title">{ locale.T(ctx, "bot.connect.title") }</h1><p class="piko-page-copy">{ locale.T(ctx, "bot.connect.copy") }</p>
 <div class="piko-connect-grid">
  <section class="piko-card piko-bot-guide" aria-labelledby="botfather-title"><span class="piko-empty-icon">@shell.Icon("telegram-logo")</span><h2 id="botfather-title">{ locale.T(ctx, "bot.guide.title") }</h2><ol><li>{ locale.T(ctx, "bot.guide.open") } <a class="piko-text-link" href="https://t.me/BotFather" rel="noreferrer"><bdi dir="ltr">{ "@BotFather" }</bdi></a></li><li>{ locale.T(ctx, "bot.guide.new") } <bdi dir="ltr">/newbot</bdi></li><li>{ locale.T(ctx, "bot.guide.existing") } <bdi dir="ltr">/mybots → API Token</bdi></li><li>{ locale.T(ctx, "bot.guide.copy") }</li></ol><p class="piko-helper">{ locale.T(ctx, "bot.guide.secret") }</p></section>
  <section class="piko-card piko-token-card" aria-labelledby="token-title"><h2 id="token-title">{ locale.T(ctx, "bot.token.heading") }</h2><form method="post" action="/bots/connect" autocomplete="off"><input type="hidden" name="csrf_token" value={ csrf }/>
   if message != "" {
 <div id="token-error" class="piko-field-error piko-bot-error" role="alert"><h3>{ message }</h3><a class="piko-text-link" href="#token">{ locale.T(ctx, "bot.error.retry") }</a></div>
 }
   <label class="piko-label" for="token">{ locale.T(ctx, "bot.token.label") }</label><input id="token" class="piko-input" name="token" type="password" dir="ltr" autocomplete="new-password" autocapitalize="none" spellcheck="false" required maxlength="160"
    if invalid {
 aria-invalid="true"
 }
    if message != "" {
 aria-describedby="token-hint token-error"
 } else {
 aria-describedby="token-hint"
 }
   /><p id="token-hint" class="piko-helper">{ locale.T(ctx, "bot.token.hint") }</p><button class="piko-primary-action" type="submit">@shell.Icon("check-circle")<span>{ locale.T(ctx, "bot.connect.submit") }</span></button><p class="piko-helper">{ locale.T(ctx, "bot.connect.readonly") }</p>
  </form></section>
 </div>
}

templ DetailPage(displayName, csrf string, bot Bot) {
 @shell.Workspace(displayName, csrf, shell.Page{Title: bot.Name, ActiveNav: shell.BotsNav, Breadcrumbs: []shell.Breadcrumb{{Label: locale.T(ctx, "workspace.bots"), URL: "/bots"}, {Label: bot.Name}}}, detailContent(bot, csrf))
}

templ detailContent(bot Bot, csrf string) {
 <div class="piko-bot-detail-heading"><span class="piko-empty-icon">@shell.Icon("robot")</span><div><h1 class="piko-page-title"><bdi dir="auto">{ bot.Name }</bdi></h1><p class="piko-page-copy"><bdi dir="ltr">{ "@" + bot.Username }</bdi></p></div></div>
 <div class="piko-connect-grid">
  <section class="piko-card piko-token-card"><h2>{ locale.T(ctx, "bot.identity.title") }</h2><dl class="piko-bot-details"><div><dt>{ locale.T(ctx, "bot.identity.id") }</dt><dd><bdi dir="ltr">{ strconv.FormatInt(bot.TelegramID, 10) }</bdi></dd></div><div><dt>{ locale.T(ctx, "bot.identity.credentials") }</dt><dd class="piko-bot-status">{ locale.T(ctx, "bot.status.verified") }</dd></div><div><dt>{ locale.T(ctx, "bot.identity.operation") }</dt><dd>{ locale.T(ctx, "delivery.state."+bot.DeliveryState) }</dd></div></dl><p class="piko-helper">{ locale.T(ctx, "bot.identity.access") }</p></section>
  <section class="piko-card piko-token-card"><h2>{ locale.T(ctx, "bot.delivery.title") }</h2><p class="piko-helper">{ locale.T(ctx, "bot.delivery.observed") }</p>
   if bot.HasWebhook && !bot.WebhookIsPiko {
 <p class="piko-bot-warning">@shell.Icon("warning-circle")<span>{ locale.T(ctx, "bot.delivery.conflict") }</span></p>
 } else if bot.WebhookIsPiko {
 <p class="piko-page-copy">{ locale.T(ctx,"delivery.webhook.piko") }</p>
 } else {
 <p class="piko-page-copy">{ locale.T(ctx, "bot.delivery.empty") }</p>
 }
   <p class="piko-page-copy">{ locale.T(ctx, "bot.delivery.pending") } <strong>{ locale.Digits(strconv.FormatInt(bot.PendingUpdates, 10)) }</strong></p><p class="piko-helper">{ locale.T(ctx, "bot.delivery.polling") }</p><p class="piko-helper">{ locale.T(ctx, "bot.connect.readonly") }</p>
   <p class="piko-helper">{ locale.T(ctx, "bot.delivery.checked") }: <time datetime={ bot.VerifiedAt.UTC().Format("2006-01-02T15:04:05Z") } data-persian-date>{ locale.T(ctx, "bot.delivery.checked") }</time></p>
  </section>
 </div>
 if bot.DeliveryError {
 <p class="piko-bot-warning" role="alert">{ locale.T(ctx,"delivery.error") }</p>
 }
 <section class="piko-card piko-token-card piko-publication"><h2>{ locale.T(ctx,"publish.title") }</h2><p>{ locale.T(ctx,"publish.version") + locale.Digits(strconv.FormatInt(bot.PublishedVersion,10)) }</p><p class="piko-helper">{ locale.T(ctx,"publish.copy") }</p><form method="post" action={ templ.URL(bot.URL()+"/publish") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="piko-primary-action" type="submit">{ locale.T(ctx,"publish.submit") }</button></form></section>
 <section class="piko-card piko-draft-section"><h2>{ locale.T(ctx,"submission.title") }</h2><p class="piko-helper">{ locale.T(ctx,"submission.copy") }</p><a class="piko-secondary-action" href={ templ.URL(bot.URL()+"/submissions") }>{ locale.T(ctx,"submission.title") }</a></section>
 <section class="piko-bot-next"><h2>{ locale.T(ctx, "bot.next.title") }</h2><p class="piko-page-copy">{ locale.T(ctx, "bot.next.copy") }</p><a class="piko-primary-action" href={ templ.URL(bot.URL()+"/draft") }>{ locale.T(ctx,"draft.title") }</a><a class="piko-secondary-action" href={ templ.URL(bot.URL()+"/activate") }>{ locale.T(ctx,"activate.title") }</a></section>
}
