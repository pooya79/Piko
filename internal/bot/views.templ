package bot

import (
 "strconv"
 "github.com/pooya79/Piko/internal/locale"
 "github.com/pooya79/Piko/internal/web/shell"
)

templ ListPage(displayName, csrf string, bots []Bot, warning bool) {
 @shell.Workspace(displayName, csrf, page(locale.T(ctx, "workspace.bots")), listContent(bots, warning))
}

templ listContent(bots []Bot, warning bool) {
 @lifecycleNotice(warning)
 <p class="piko-page-copy"><a class="piko-text-link" href="/bots/connect">{ locale.T(ctx,"bot.connect.title") }</a></p>
 <div class="piko-section-heading"><h1 class="piko-page-title">{ locale.T(ctx, "workspace.bots") }</h1><a class="piko-primary-action" href="/bots/new">@shell.Icon("plus")<span>{ locale.T(ctx, "bot.create.title") }</span></a></div>
 if len(bots) == 0 {
  <section class="piko-card piko-bot-empty"><span class="piko-empty-icon">@shell.Icon("robot")</span><h2>{ locale.T(ctx, "dashboard.bots.empty") }</h2><p class="piko-page-copy">{ locale.T(ctx, "bot.list.empty") }</p><a class="piko-text-link" href="/bots/new">{ locale.T(ctx, "bot.create.title") }</a></section>
 } else {
  <p class="piko-page-copy">{ locale.T(ctx, "bot.list.copy") }</p>
  @Cards(bots)
 }
}

templ Cards(bots []Bot) {
 <div class="piko-bot-grid">
  for _, bot := range bots {
   <article class="piko-card piko-bot-card"><span class="piko-empty-icon">@shell.Icon("robot")</span><h2><a href={ templ.URL(bot.URL()) }><bdi dir="auto">{ bot.Name }</bdi></a></h2>
   if !bot.Unconnected {
    <p><bdi dir="ltr">{ "@" + bot.Username }</bdi></p>
 }
<p class="piko-bot-status">@shell.Icon("check-circle")<span>{ locale.T(ctx, credentialStatus(bot)) }</span></p><p class="piko-helper">{ locale.T(ctx, "delivery.state."+bot.DeliveryState) }</p>
   if bot.DeliveryMode != "" {
    <p class="piko-helper">{ locale.T(ctx,"delivery.mode."+string(bot.DeliveryMode)) }</p>
   }
   <a class="piko-text-link" href={ templ.URL(bot.URL()) }>{ locale.T(ctx, "bot.detail.link") }</a></article>
  }
 </div>
}

templ ConnectPage(displayName, csrf, message string, invalid bool) {
 @shell.Workspace(displayName, csrf, shell.Page{Title: locale.T(ctx, "bot.connect.title"), ActiveNav: shell.BotsNav, Breadcrumbs: []shell.Breadcrumb{{Label: locale.T(ctx, "workspace.bots"), URL: "/bots"}, {Label: locale.T(ctx, "bot.connect.title")}}}, connectContent(csrf, message, invalid, "/bots/connect", "bot.connect.copy", ""))
}

templ ConnectExistingPage(displayName, csrf string, bot Bot, message string, invalid bool, existingURL string) {
 @shell.Workspace(displayName, csrf, flowPage(ctx, bot, "bot.connect.title"), existingConnectContent(csrf, bot, message, invalid, existingURL))
}

templ existingConnectContent(csrf string, bot Bot, message string, invalid bool, existingURL string) {
 <p class="piko-page-copy"><bdi dir="auto">{ bot.Name }</bdi></p>
 @connectContent(csrf, message, invalid, bot.URL()+"/connect", "bot.connect.existing.copy", existingURL)
}

templ connectContent(csrf, message string, invalid bool, action, copyKey, existingURL string) {
 <h1 class="piko-page-title">{ locale.T(ctx, "bot.connect.title") }</h1><p class="piko-page-copy">{ locale.T(ctx, copyKey) }</p>
 <div class="piko-connect-grid">
  <section class="piko-card piko-bot-guide" aria-labelledby="botfather-title"><span class="piko-empty-icon">@shell.Icon("telegram-logo")</span><h2 id="botfather-title">{ locale.T(ctx, "bot.guide.title") }</h2><ol><li>{ locale.T(ctx, "bot.guide.open") } <a class="piko-text-link" href="https://t.me/BotFather" rel="noreferrer"><bdi dir="ltr">{ "@BotFather" }</bdi></a></li><li>{ locale.T(ctx, "bot.guide.new") } <bdi dir="ltr">/newbot</bdi></li><li>{ locale.T(ctx, "bot.guide.existing") } <bdi dir="ltr">/mybots → API Token</bdi></li><li>{ locale.T(ctx, "bot.guide.copy") }</li></ol><p class="piko-helper">{ locale.T(ctx, "bot.guide.secret") }</p></section>
  <section class="piko-card piko-token-card" aria-labelledby="token-title"><h2 id="token-title">{ locale.T(ctx, "bot.token.heading") }</h2><form method="post" action={ templ.URL(action) } autocomplete="off"><input type="hidden" name="csrf_token" value={ csrf }/>
   if message != "" {
 <div id="token-error" class="piko-field-error piko-bot-error" role="alert"><h3>{ message }</h3>
 if existingURL != "" {
 <p><a class="piko-text-link" href={ templ.URL(existingURL) }>{ locale.T(ctx, "bot.connect.duplicate.link") }</a></p>
 }
 <a class="piko-text-link" href="#token">{ locale.T(ctx, "bot.error.retry") }</a></div>
 }
   <label class="piko-label" for="token">{ locale.T(ctx, "bot.token.label") }</label><input id="token" class="piko-input" name="token" type="password" dir="ltr" autocomplete="new-password" autocapitalize="none" spellcheck="false" required maxlength="160"
    if invalid {
 aria-invalid="true"
 }
    if message != "" {
 aria-describedby="token-hint token-error"
 } else {
 aria-describedby="token-hint"
 }
   /><p id="token-hint" class="piko-helper">{ locale.T(ctx, "bot.token.hint") }</p><button class="piko-primary-action" type="submit">@shell.Icon("check-circle")<span>{ locale.T(ctx, "bot.connect.submit") }</span></button><p class="piko-helper">{ locale.T(ctx, "bot.connect.readonly") }</p>
  </form></section>
 </div>
}

templ DetailPage(displayName, csrf string, bot Bot, warning bool) {
 @shell.Workspace(displayName, csrf, shell.Page{Title: bot.Name, ActiveNav: shell.BotsNav, Breadcrumbs: []shell.Breadcrumb{{Label: locale.T(ctx, "workspace.bots"), URL: "/bots"}, {Label: bot.Name}}}, detailContent(bot, csrf, warning))
}

templ detailContent(bot Bot, csrf string, warning bool) {
 @lifecycleNotice(warning)
 <p class="piko-page-copy"><a class="piko-text-link" href={ templ.URL(bot.URL()+"/chats") }>{ locale.T(ctx,"builder.title") }</a></p>
 <div class="piko-bot-detail-heading"><span class="piko-empty-icon">@shell.Icon("robot")</span><div><h1 class="piko-page-title"><bdi dir="auto">{ bot.Name }</bdi></h1>
 if !bot.Unconnected {
 <p class="piko-page-copy"><bdi dir="ltr">{ "@" + bot.Username }</bdi></p>
 }
</div></div>
 @DeployControls(csrf,bot)
 <div class="piko-connect-grid">
  <section class="piko-card piko-token-card"><h2>{ locale.T(ctx, "bot.identity.title") }</h2><dl class="piko-bot-details"><div><dt>{ locale.T(ctx, "bot.identity.id") }</dt><dd>
 if bot.Unconnected {
 { locale.T(ctx,"bot.unconnected.identity") }
 } else {
 <bdi dir="ltr">{ strconv.FormatInt(bot.TelegramID, 10) }</bdi>
 }
 </dd></div><div><dt>{ locale.T(ctx, "bot.identity.credentials") }</dt><dd class="piko-bot-status">{ locale.T(ctx, credentialStatus(bot)) }</dd></div><div><dt>{ locale.T(ctx, "bot.identity.operation") }</dt><dd>{ locale.T(ctx, "delivery.state."+bot.DeliveryState) }</dd></div></dl>
   if bot.DeliveryMode != "" {
    <p class="piko-helper">{ locale.T(ctx,"delivery.mode."+string(bot.DeliveryMode)) }</p>
   }
   if !bot.Unconnected {
 <p class="piko-helper">{ locale.T(ctx, "bot.identity.access") }</p>
 }
 </section>
  if !bot.Unconnected && !bot.Disconnected {
  <section class="piko-card piko-token-card"><h2>{ locale.T(ctx, "bot.delivery.title") }</h2><p class="piko-helper">{ locale.T(ctx, "bot.delivery.observed") }</p>
   if bot.HasWebhook && !bot.WebhookIsPiko {
 <p class="piko-bot-warning">@shell.Icon("warning-circle")<span>{ locale.T(ctx, "bot.delivery.conflict") }</span></p>
 } else if bot.WebhookIsPiko {
 <p class="piko-page-copy">{ locale.T(ctx,"delivery.webhook.piko") }</p>
 } else {
 <p class="piko-page-copy">{ locale.T(ctx, "bot.delivery.empty") }</p>
 }
   <p class="piko-page-copy">{ locale.T(ctx, "bot.delivery.pending") } <strong>{ locale.Digits(strconv.FormatInt(bot.PendingUpdates, 10)) }</strong></p><p class="piko-helper">{ locale.T(ctx, "bot.delivery.polling") }</p><p class="piko-helper">{ locale.T(ctx, "bot.connect.readonly") }</p>
   <p class="piko-helper">{ locale.T(ctx, "bot.delivery.checked") }: <time datetime={ bot.VerifiedAt.UTC().Format("2006-01-02T15:04:05Z") } data-persian-date>{ locale.T(ctx, "bot.delivery.checked") }</time></p>
  </section>
 } else if bot.Unconnected {
 <section class="piko-card piko-token-card"><h2>{ locale.T(ctx,"bot.status.unconnected") }</h2><p class="piko-page-copy">{ locale.T(ctx,"bot.unconnected.copy") }</p><a class="piko-primary-action" href={ templ.URL(bot.URL()+"/connect") }>@shell.Icon("telegram-logo")<span>{ locale.T(ctx,"bot.connect.title") }</span></a></section>
 } else {
 <section class="piko-card piko-token-card"><h2>{ locale.T(ctx,"lifecycle.reconnect.title") }</h2><p class="piko-page-copy">{ locale.T(ctx,"lifecycle.disconnected.copy") }</p></section>
 }
 </div>
 @lifecycleControls(bot, csrf)
 if bot.DeliveryError {
  if bot.DeliveryMode == PollingDelivery {
   <p class="piko-bot-warning" role="alert">{ locale.T(ctx,"delivery.polling.error") }</p>
  } else {
   <p class="piko-bot-warning" role="alert">{ locale.T(ctx,"delivery.error") }</p>
  }
 }
 if bot.DeliveryState == "active" || bot.DeliveryState == "paused" {
  <section class="piko-card piko-token-card piko-publication"><h2>{ locale.T(ctx,"pause.title") }</h2><p class="piko-bot-status">{ locale.T(ctx,"delivery.state."+bot.DeliveryState) }</p><p class="piko-helper">{ locale.T(ctx,"pause.copy") }</p>
   if bot.Paused {
    <form method="post" action={ templ.URL(bot.URL()+"/resume") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="piko-primary-action" type="submit">{ locale.T(ctx,"pause.resume") }</button></form>
   } else {
    <form method="post" action={ templ.URL(bot.URL()+"/pause") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="piko-secondary-action" type="submit">{ locale.T(ctx,"pause.submit") }</button></form>
   }
  </section>
 }
 <section class="piko-card piko-token-card piko-publication"><h2>{ locale.T(ctx,"publish.title") }</h2><p>{ locale.T(ctx,"publish.version") + locale.Digits(strconv.FormatInt(bot.PublishedVersion,10)) }</p><p class="piko-helper">{ locale.T(ctx,"publish.copy") }</p><p class="piko-helper">{ locale.T(ctx,"publish.interactions") }</p><form method="post" action={ templ.URL(bot.URL()+"/publish") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="piko-primary-action" type="submit">{ locale.T(ctx,"publish.submit") }</button></form></section>
 <section class="piko-card piko-draft-section"><h2>{ locale.T(ctx,"submission.title") }</h2><p class="piko-helper">{ locale.T(ctx,"submission.copy") }</p><a class="piko-secondary-action" href={ templ.URL(bot.URL()+"/submissions") }>{ locale.T(ctx,"submission.title") }</a></section>
 <section class="piko-bot-next"><h2>
 if bot.Unconnected {
 { locale.T(ctx,"draft.title") }
 } else {
 { locale.T(ctx, "bot.next.title") }
 }
 </h2><p class="piko-page-copy">{ locale.T(ctx, "bot.next.copy") }</p><a class="piko-primary-action" href={ templ.URL(bot.URL()+"/draft") }>{ locale.T(ctx,"draft.title") }</a>if !bot.Unconnected && !bot.Disconnected {
 <a class="piko-secondary-action" href={ templ.URL(bot.URL()+"/activate") }>{ locale.T(ctx,"activate.title") }</a>
 }</section>
}
