package bot

import (
 "github.com/pooya79/Piko/internal/locale"
 "github.com/pooya79/Piko/internal/web/shell"
)

templ ListPage(displayName, csrf string, bots []Bot, warning bool) {
 @shell.Workspace(displayName, csrf, page(locale.T(ctx, "workspace.bots")), listContent(bots, warning))
}

templ listContent(bots []Bot, warning bool) {
 @lifecycleNotice(warning)
 <div class="piko-section-heading"><h1 class="piko-page-title">{ locale.T(ctx, "workspace.bots") }</h1><a class="piko-primary-action" href="/bots/new">@shell.Icon("plus")<span>{ locale.T(ctx, "bot.create.title") }</span></a></div>
 if len(bots) == 0 {
  <section class="piko-card piko-bot-empty"><span class="piko-empty-icon">@shell.Icon("robot")</span><h2>{ locale.T(ctx, "dashboard.bots.empty") }</h2><p class="piko-page-copy">{ locale.T(ctx, "bot.list.empty") }</p><a class="piko-text-link" href="/bots/new">{ locale.T(ctx, "bot.create.title") }</a></section>
 } else {
  <p class="piko-page-copy">{ locale.T(ctx, "bot.list.copy") }</p>
  @Cards(bots)
 }
}

templ Cards(bots []Bot) {
 <div class="piko-bot-grid">
  for _, bot := range bots {
   <article class="piko-card piko-bot-card" data-bot-state={ overviewState(bot) }>
    <div class="piko-bot-card-top"><span class="piko-empty-icon">@shell.Icon("robot")</span><span class="piko-bot-card-status" title={ locale.T(ctx, overviewStatusKey(bot)) }>{ locale.T(ctx, overviewStatusKey(bot)) }</span></div>
    <div class="piko-bot-card-identity">
     <h2><a class="piko-bot-card-link" href={ templ.URL(bot.URL()) } aria-label={ locale.T(ctx, "bot.detail.link") + ": " + bot.Name } title={ bot.Name }><bdi dir="auto">{ bot.Name }</bdi></a></h2>
     <p class="piko-helper">
      if bot.Unconnected {
       { locale.T(ctx, "bot.card.noidentity") }
      } else {
       <bdi dir="ltr">{ "@" + bot.Username }</bdi>
      }
     </p>
    </div>
    <dl class="piko-bot-card-facts">
     <div><dt>@shell.Icon("telegram-logo")<span>{ locale.T(ctx, "bot.card.connection") }</span></dt><dd>
      if bot.Unconnected || bot.Disconnected {
       { locale.T(ctx, "bot.card.notconnected") }
      } else {
       { locale.T(ctx, "bot.card.connected") }
      }
     </dd></div>
     <div><dt>@shell.Icon("squares-four")<span>{ locale.T(ctx, "bot.card.flow") }</span></dt><dd>
      if bot.HasImplementation {
       { locale.T(ctx, "bot.card.built") }
      } else {
       { locale.T(ctx, "bot.card.notbuilt") }
      }
     </dd></div>
    </dl>
    <p class="piko-bot-card-delivery"
     if bot.DeliveryMode != "" {
      title={ locale.T(ctx, "delivery.mode."+string(bot.DeliveryMode)) }
     }
    >
     if bot.DeliveryMode != "" {
      { locale.T(ctx, "delivery.mode."+string(bot.DeliveryMode)) }
     }
    </p>
    <div class="piko-bot-card-actions">
     <a class="piko-primary-action" href={ templ.URL(bot.URL()+"/studio") }>
      if bot.HasImplementation {
       @shell.Icon("sliders")<span>{ locale.T(ctx, "bot.card.edit") }</span>
      } else {
       @shell.Icon("sparkle")<span>{ locale.T(ctx, "bot.card.build") }</span>
      }
     </a>
     if bot.Unconnected {
      <a class="piko-secondary-action" href={ templ.URL(bot.URL()+"/connect") }>@shell.Icon("telegram-logo")<span>{ locale.T(ctx, "bot.card.connect") }</span></a>
     } else if bot.Disconnected {
      <a class="piko-secondary-action" href={ templ.URL(bot.URL()+"/connection") }>@shell.Icon("arrow-clockwise")<span>{ locale.T(ctx, "bot.card.reconnect") }</span></a>
     }
    </div>
   </article>
  }
 </div>
}

templ ConnectPage(displayName, csrf, message string, invalid bool) {
 @shell.Workspace(displayName, csrf, shell.Page{Title: locale.T(ctx, "bot.connect.title"), ActiveNav: shell.BotsNav, Breadcrumbs: []shell.Breadcrumb{{Label: locale.T(ctx, "workspace.bots"), URL: "/bots"}, {Label: locale.T(ctx, "bot.connect.title")}}}, connectContent(csrf, message, invalid, "/bots/connect", "bot.connect.copy", "", "bot.connect.title", "bot.connect.submit"))
}

templ ConnectExistingPage(displayName, csrf string, bot Bot, message string, invalid bool, existingURL string) {
 @shell.Workspace(displayName, csrf, flowPage(ctx, bot, "bot.connect.title"), existingConnectContent(csrf, bot, message, invalid, existingURL))
}

templ existingConnectContent(csrf string, bot Bot, message string, invalid bool, existingURL string) {
 <p class="piko-page-copy"><bdi dir="auto">{ bot.Name }</bdi></p>
 @connectContent(csrf, message, invalid, bot.URL()+"/connect", "bot.connect.existing.copy", existingURL, "bot.connect.title", "bot.connect.submit")
 <p class="piko-page-copy"><a class="piko-text-link" href={ templ.URL(bot.URL()+"/studio") }>{ locale.T(ctx,"bot.overview.change") }</a></p>
}

templ connectContent(csrf, message string, invalid bool, action, copyKey, existingURL, titleKey, submitKey string) {
 <h1 class="piko-page-title">{ locale.T(ctx, titleKey) }</h1><p class="piko-page-copy">{ locale.T(ctx, copyKey) }</p>
 <div class="piko-connect-grid">
  <section class="piko-card piko-bot-guide" aria-labelledby="botfather-title"><span class="piko-empty-icon">@shell.Icon("telegram-logo")</span><h2 id="botfather-title">{ locale.T(ctx, "bot.guide.title") }</h2><ol><li>{ locale.T(ctx, "bot.guide.open") } <a class="piko-text-link" href="https://t.me/BotFather" target="_blank" rel="noopener noreferrer"><bdi dir="ltr">{ "@BotFather" }</bdi></a></li><li>{ locale.T(ctx, "bot.guide.new") } <bdi dir="ltr">/newbot</bdi></li><li>{ locale.T(ctx, "bot.guide.existing") } <bdi dir="ltr">/mybots → API Token</bdi></li><li>{ locale.T(ctx, "bot.guide.copy") }</li></ol><p class="piko-helper">{ locale.T(ctx, "bot.guide.secret") }</p></section>
  <section class="piko-card piko-token-card" aria-labelledby="token-title"><h2 id="token-title">{ locale.T(ctx, "bot.token.heading") }</h2><form method="post" action={ templ.URL(action) } autocomplete="off"><input type="hidden" name="csrf_token" value={ csrf }/>
   if message != "" {
 <div id="token-error" class="piko-field-error piko-bot-error" role="alert"><h3>{ message }</h3>
 if existingURL != "" {
 <p><a class="piko-text-link" href={ templ.URL(existingURL) }>{ locale.T(ctx, "bot.connect.duplicate.link") }</a></p>
 }
 <a class="piko-text-link" href="#token">{ locale.T(ctx, "bot.error.retry") }</a></div>
 }
   <label class="piko-label" for="token">{ locale.T(ctx, "bot.token.label") }</label><input id="token" class="piko-input" name="token" type="password" dir="ltr" autocomplete="new-password" autocapitalize="none" spellcheck="false" required maxlength="160"
    if invalid {
 aria-invalid="true"
 }
    if message != "" {
 aria-describedby="token-hint token-error"
 } else {
 aria-describedby="token-hint"
 }
   /><p id="token-hint" class="piko-helper">{ locale.T(ctx, "bot.token.hint") }</p><button class="piko-primary-action" type="submit">@shell.Icon("check-circle")<span>{ locale.T(ctx, submitKey) }</span></button><p class="piko-helper">{ locale.T(ctx, "bot.connect.readonly") }</p>
  </form></section>
 </div>
}

templ DetailPage(displayName, csrf string, bot Bot, warning bool) {
 @shell.Workspace(displayName, csrf, shell.Page{Title: bot.Name, BotURL: bot.URL(), BotSection: shell.BotOverview, ActiveNav: shell.BotsNav, Breadcrumbs: []shell.Breadcrumb{{Label: locale.T(ctx, "workspace.bots"), URL: "/bots"}, {Label: bot.Name}}}, detailContent(bot, csrf, warning))
}
