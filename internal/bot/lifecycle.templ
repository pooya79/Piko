package bot

import (
 "strconv"
 "github.com/pooya79/Piko/internal/locale"
 "github.com/pooya79/Piko/internal/web/shell"
)

templ lifecycleNotice(warning bool) {
 if warning {
  <p class="piko-bot-warning" role="alert">{ locale.T(ctx,"lifecycle.cleanup.warning") }</p>
 }
}

templ settingsControls(bot Bot, csrf, name, key string) {
 <div class="piko-card piko-settings-panel">
  <section class="piko-setting-row" aria-labelledby="workspace-name-title">
   <div><h2 id="workspace-name-title">{ locale.T(ctx,"bot.name.edit") }</h2><p>{ locale.T(ctx,"bot.name.hint") }</p></div>
   <form method="post" action={ templ.URL(bot.URL()+"/name") }>
    <input type="hidden" name="csrf_token" value={ csrf }/>
    <label class="piko-label" for="bot-name">{ locale.T(ctx,"bot.create.name") }</label>
    if key != "" {
     <p id="bot-name-error" class="piko-field-error" role="alert">{ locale.T(ctx,key) }</p>
    }
    <input class="piko-input" id="bot-name" name="name" value={ name } dir="auto" required maxlength="80" autofocus?={ key!="" }
     if key=="bot.create.name.error" {
      aria-invalid="true"
     }
     if key!="" {
      aria-describedby="bot-name-hint bot-name-error"
     } else {
      aria-describedby="bot-name-hint"
     }
    />
    <p id="bot-name-hint" class="piko-helper">{ locale.T(ctx,"bot.name.limit") }</p>
    <button class="piko-primary-action" type="submit">{ locale.T(ctx,"bot.name.save") }</button>
   </form>
  </section>
  <section class="piko-setting-row" aria-labelledby="manual-settings-title">
   <div><h2 id="manual-settings-title">{ locale.T(ctx,"draft.title") }</h2><p>{ locale.T(ctx,"bot.settings.draft.copy") }</p></div>
   <a class="piko-secondary-action" href={ templ.URL(bot.URL()+"/draft") }>@shell.Icon("sliders")<span>{ locale.T(ctx,"bot.settings.draft.open") }</span></a>
  </section>
  <section class="piko-setting-row" aria-labelledby="connection-settings-title">
   <div><h2 id="connection-settings-title">{ locale.T(ctx,"bot.connection.title") }</h2><p>{ locale.T(ctx,"bot.settings.connection.copy") }</p></div>
   <a class="piko-secondary-action" href={ templ.URL(bot.URL()+"/connection") }>{ locale.T(ctx,"bot.connection.title") }</a>
  </section>
  <section class="piko-setting-row piko-settings-danger" aria-labelledby="delete-settings-title">
   <div><h2 id="delete-settings-title">{ locale.T(ctx,"lifecycle.delete.title") }</h2><p>{ locale.T(ctx,"bot.settings.delete.copy") }</p></div>
   <a class="piko-secondary-action piko-danger-action" href={ templ.URL(bot.URL()+"/settings/delete") }>{ locale.T(ctx,"lifecycle.delete.title") }</a>
  </section>
 </div>
}

templ DeletePage(displayName, csrf string, b Bot, key string) {
 @shell.Workspace(displayName, csrf, flowPage(ctx,b,"bot.settings.title"), deleteContent(csrf,b,key))
}

templ deleteContent(csrf string, b Bot, key string) {
 <h1 class="piko-page-title">{ locale.T(ctx,"lifecycle.delete.title") }</h1>
 <p class="piko-page-copy"><bdi dir="auto">{ b.Name }</bdi></p>
 <section class="piko-card piko-delete-panel" aria-labelledby="delete-scope-title">
  <h2 id="delete-scope-title">{ locale.T(ctx,"lifecycle.delete.scope") }</h2>
  <p>{ locale.T(ctx,"lifecycle.delete.copy") }</p>
  <ul class="piko-delete-scope">
   <li>{ locale.T(ctx,"lifecycle.delete.flows") }</li>
   <li>{ locale.T(ctx,"lifecycle.delete.chats") }</li>
   <li>{ locale.T(ctx,"lifecycle.delete.data") }</li>
  </ul>
  <p>{ locale.T(ctx,"lifecycle.delete.preserved") }</p>
  <form method="post" action={ templ.URL(b.URL()+"/delete") }>
   <input type="hidden" name="csrf_token" value={ csrf }/>
   if key != "" {
    <p id="delete-error" class="piko-field-error" role="alert">{ locale.T(ctx,key) }</p>
   }
   <label class="piko-activation-confirm"><input id="confirm-delete" type="checkbox" name="confirm_delete" value="yes" required autofocus?={ key!="" }
    if key!="" {
     aria-describedby="delete-error"
    }
   /><span>{ locale.T(ctx,"lifecycle.delete.check") } <bdi dir="auto">{ b.Name }</bdi></span></label>
   <div class="piko-draft-actions"><button class="piko-secondary-action piko-danger-action" type="submit">{ locale.T(ctx,"lifecycle.delete.submit") }</button><a class="piko-text-link" href={ templ.URL(b.URL()+"/settings") }>{ locale.T(ctx,"lifecycle.delete.cancel") }</a></div>
  </form>
 </section>
}

templ lifecycleToken(action, csrf, submitKey, key string, invalid bool) {
 <form method="post" action={ templ.URL(action) } autocomplete="off">
  <input type="hidden" name="csrf_token" value={ csrf }/>
  <label class="piko-label" for="lifecycle-token">{ locale.T(ctx,"bot.token.label") }</label>
  if key != "" {
   <p id="lifecycle-token-error" class="piko-field-error piko-bot-error" role="alert">{ locale.T(ctx,key) }</p>
  }
  <input id="lifecycle-token" name="token" class="piko-input" type="password" dir="ltr" autocomplete="new-password" autocapitalize="none" spellcheck="false" required maxlength="160"
   if invalid {
    aria-invalid="true"
   }
   if key != "" {
    aria-describedby="lifecycle-token-hint lifecycle-token-error"
   } else {
    aria-describedby="lifecycle-token-hint"
   }
  />
  <p id="lifecycle-token-hint" class="piko-helper">{ locale.T(ctx,"bot.guide.secret") }</p>
  <button class="piko-primary-action" type="submit">{ locale.T(ctx,submitKey) }</button>
 </form>
}

templ connectionControls(bot Bot, csrf, key string, invalid bool) {
 @connectionIdentity(bot)
 <div class="piko-connect-grid">
  <section class="piko-card piko-token-card">
   if bot.Disconnected {
    <h2>{ locale.T(ctx,"lifecycle.reconnect.title") }</h2><p class="piko-helper">{ locale.T(ctx,"lifecycle.reconnect.copy") }</p>
    @lifecycleToken(bot.URL()+"/reconnect", csrf, "lifecycle.reconnect.submit", key, invalid)
   } else {
    <h2>{ locale.T(ctx,"lifecycle.replace.title") }</h2><p class="piko-helper">{ locale.T(ctx,"lifecycle.replace.copy") }</p>
    @lifecycleToken(bot.URL()+"/replace-token", csrf, "lifecycle.replace.submit", key, invalid)
    <div class="piko-lifecycle-delete"><p class="piko-helper">{ locale.T(ctx,"lifecycle.disconnect.copy") }</p><a class="piko-text-link" href={ templ.URL(bot.URL()+"/connection/disconnect") }>{ locale.T(ctx,"lifecycle.disconnect.title") }</a></div>
   }
  </section>
  if !bot.Disconnected {
   @connectionObservation(bot)
  }
 </div>
}

templ connectionIdentity(b Bot) {
 <dl class="piko-connection-identity"><div><dt>{ locale.T(ctx,"bot.identity.id") }</dt><dd><bdi dir="ltr">{ strconv.FormatInt(b.TelegramID,10) }</bdi></dd></div><div><dt>{ locale.T(ctx,"bot.connection.identity") }</dt><dd><bdi dir="ltr">{ "@"+b.Username }</bdi></dd></div><div><dt>{ locale.T(ctx,"bot.identity.credentials") }</dt><dd>{ locale.T(ctx,credentialStatus(b)) }</dd></div></dl>
}

templ DisconnectPage(displayName, csrf string, b Bot, key string) {
 @shell.Workspace(displayName, csrf, flowPage(ctx,b,"bot.connection.title"), disconnectContent(csrf,b,key))
}

templ disconnectContent(csrf string, b Bot, key string) {
 <h1 class="piko-page-title">{ locale.T(ctx,"lifecycle.disconnect.title") }</h1>
 <p class="piko-page-copy"><bdi dir="auto">{ b.Name }</bdi></p>
 @connectionIdentity(b)
 <section class="piko-card piko-token-card piko-activation">
  <h2>{ locale.T(ctx,"lifecycle.disconnect.confirm") }</h2>
  if key != "" {
   <p class="piko-field-error" role="alert">{ locale.T(ctx,key) }</p>
  }
  <p class="piko-page-copy">{ locale.T(ctx,"lifecycle.disconnect.copy") }</p>
  <form method="post" action={ templ.URL(b.URL()+"/disconnect") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="piko-secondary-action" type="submit">{ locale.T(ctx,"lifecycle.disconnect.submit") }</button></form>
  <p class="piko-page-copy"><a class="piko-text-link" href={ templ.URL(b.URL()+"/connection") }>{ locale.T(ctx,"bot.connection.cancel") }</a></p>
 </section>
}
