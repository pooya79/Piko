package builder

import (
	 "context"
 "strconv"
 "github.com/pooya79/Piko/internal/bot"
 "github.com/pooya79/Piko/internal/locale"
 "github.com/pooya79/Piko/internal/web/shell"
)

func page(ctx context.Context, b bot.Bot) shell.Page {
 if b.ID == 0 { return shell.Page{Title:locale.T(ctx,"piko.chat.title"),ActiveNav:shell.BuilderNav,Breadcrumbs:[]shell.Breadcrumb{{Label:locale.T(ctx,"piko.chat.title"),URL:"/builder"}}} }
 return shell.Page{Title:locale.T(ctx,"builder.title"),BotURL:b.URL(),BotSection:shell.BotStudio,ActiveNav:shell.BuilderNav,Breadcrumbs:[]shell.Breadcrumb{{Label:locale.T(ctx,"workspace.bots"),URL:"/bots"},{Label:b.Name,URL:b.URL()},{Label:locale.T(ctx,"builder.title"),URL:b.URL()+"/studio"}}}
}

templ IndexPage(displayName,csrf string,chats []Chat,view ChatView) {
 @shell.Workspace(displayName,csrf,shell.Page{Title:locale.T(ctx,"piko.chat.title"),ActiveNav:shell.BuilderNav},indexDocument(csrf,chats,view))
}

templ indexDocument(csrf string,chats []Chat,view ChatView) {
 <script src="/static/studio.js?v=studio6" defer></script>
 <script src="/static/studio-preview.js?v=preview2" defer></script>
 <script src="/static/studio-panes.js?v=panes1" defer></script>
 <script src="/static/builder-status.js?v=studio3" defer></script>
 @indexContent(csrf,chats,view)
}

templ indexContent(csrf string,chats []Chat,view ChatView) {
 <section class="piko-studio" data-piko-studio data-chat-url="/builder" data-draft-key={ view.DraftKey }>
  <header class="piko-studio-heading"><div class="piko-studio-identity"><img src="/static/brand/piko-mark-v2.webp" width="32" height="32" alt=""/><h1>{ locale.T(ctx,"piko.chat.title") }</h1></div></header>
  @studioSwitch()
  <div class="piko-studio-body">
   @chatSidebar(csrf,bot.Bot{},chats,view.Bots,0)
   <section id="studio-conversation" class="piko-studio-conversation" aria-label={ locale.T(ctx,"piko.chat.title") } tabindex="-1">
    <div class="piko-studio-scroll">@welcomeExamples()</div>
    <p class="piko-field-error" role="status" data-studio-refresh-error hidden>{ locale.T(ctx,"studio.refresh.error") } <button type="button" data-studio-refresh class="piko-text-link">{ locale.T(ctx,"builder.refresh") }</button></p>
    @composer(csrf,"/chats",view,false)
   </section>
   @studioPane(csrf,bot.Bot{},Conversation{},view)
  </div>
 </section>
}

templ welcomeExamples() {
 <section class="piko-studio-welcome" aria-labelledby="studio-welcome">
  <img src="/static/brand/piko-mark-v2.webp" width="56" height="56" alt=""/>
  <h2 id="studio-welcome">{ locale.T(ctx,"studio.welcome.heading") }</h2>
  <p>{ locale.T(ctx,"studio.welcome.copy") }</p>
  <div class="piko-studio-examples">
   @example("inquiry","chat-circle-dots")
   @example("registration","users")
   @example("booking","calendar-blank")
  </div>
 </section>
}

templ example(kind,icon string) {
 <button id={ "studio-example-"+kind } type="button" class="piko-studio-example" data-example={ kind } data-prompt={ locale.T(ctx,"studio.example."+kind+".prompt") }>@shell.Icon(icon)<strong>{ locale.T(ctx,"studio.example."+kind+".title") }</strong>@shell.Icon("arrow-up-left")</button>
}

templ composer(csrf,action string,view ChatView,running bool) {
 <section class="piko-studio-composer">
  if view.FeedbackKey!="" {
 <p class="piko-field-error" role="alert"
 if view.FeedbackKey=="flow.stale" {
 data-flow-stale-feedback
 }
 >{ locale.T(ctx,view.FeedbackKey) }</p>
 }
  <p class="sr-only" id="builder-capabilities">{ locale.T(ctx,"studio.composer.hint") }</p>
  if !view.Enabled {
 <p id="builder-unavailable" class="piko-field-error">{ locale.T(ctx,"piko.chat.unavailable") }</p>
 }
  <form method="post" data-studio-form="message"
   if view.Enabled {
 action={ templ.URL(action) }
 }
  >
   <input type="hidden" name="csrf_token" value={ csrf }/>
   <input type="hidden" name="request_key" value={ view.RequestKey }/>
 <input type="hidden" name="selected_block" value={ view.Selection.Key }/>
 <input type="hidden" name="selected_revision" value={ selectionRevision(view.Selection) }/>
 <p class="piko-helper" data-flow-request hidden?={ view.Selection.Key=="" }>{ locale.T(ctx,"flow.selected") } <bdi dir="ltr" data-flow-request-label>{ view.Selection.Key }</bdi><span data-flow-request-stale hidden>{ locale.T(ctx,"flow.stale") }</span><button id="flow-clear-selection" type="button" data-flow-clear class="piko-text-link">{ locale.T(ctx,"flow.clear") }</button></p>
   <label class="sr-only" for="builder-message">{ locale.T(ctx,"builder.message") }</label>
   <textarea id="builder-message" name="message" dir="auto" class="piko-input piko-builder-composer" placeholder={ locale.T(ctx,"studio.composer.placeholder") } maxlength="32768" required
    if !view.Enabled {
 aria-describedby="builder-capabilities builder-unavailable"
 } else {
 aria-describedby="builder-capabilities"
 }
   >{ view.Message }</textarea>
   <div class="piko-studio-composer-actions"><button id="studio-send" class="piko-primary-action" type="submit" disabled?={ !view.Enabled || running } data-can-send={ strconv.FormatBool(view.Enabled && !running) }>@shell.Icon("arrow-up-left")
 <span class="sr-only">{ locale.T(ctx,"builder.send") }</span></button></div>
  </form>
  <div class="piko-context-usage" title={ locale.T(ctx,"builder.memory.hint") }>
   <svg class="piko-context-ring" viewBox="0 0 20 20" role="meter" aria-label={ locale.T(ctx,"builder.memory.label") } aria-valuemin="0" aria-valuemax="64000" aria-valuenow={ strconv.Itoa(min(view.MemoryTokens,memoryTokenLimit)) } aria-valuetext={ locale.Digits(strconv.Itoa(view.MemoryTokens))+" / 64k · "+locale.T(ctx,"builder.memory.estimate") }>
    <circle class="piko-context-track" cx="10" cy="10" r="8"/>
    <circle class="piko-context-fill" cx="10" cy="10" r="8" pathLength="100" stroke-dasharray={ strconv.FormatFloat(float64(min(view.MemoryTokens,memoryTokenLimit))/640, 'f', 2, 64)+" 100" }/>
   </svg>
   <bdi dir="ltr">{ locale.Digits(strconv.Itoa(view.MemoryTokens))+" / 64k" }</bdi>
   <span class="sr-only">{ locale.T(ctx,"builder.memory.estimate") }</span>
  </div>
 </section>
}

templ NewChatPage(displayName,csrf string,b bot.Bot,history Conversation,view ChatView) {
 @shell.Workspace(displayName,csrf,page(ctx,b),chatDocument(csrf,b,history,view))
}

templ ChatPage(displayName,csrf string,b bot.Bot,history Conversation,view ChatView) {
 {{ c := history.Chat }}
 {{ p := page(ctx,b); p.Title=c.Title; p.Breadcrumbs=append(p.Breadcrumbs,shell.Breadcrumb{Label:c.Title}) }}
 @shell.Workspace(displayName,csrf,p,chatDocument(csrf,b,history,view))
}

templ chatContent(csrf string,b bot.Bot,history Conversation,view ChatView) {
 {{ c := history.Chat }}
 {{ chatURL := c.URL(); messageURL := chatURL+"/messages"; if c.ID==0 { chatURL=b.URL()+"/studio"; messageURL=b.URL()+"/chats" } }}
 {{ latest := history.LatestRun() }}
 <section class="piko-studio" data-piko-studio data-chat-url={ chatURL } data-draft-key={ view.DraftKey }
  if c.ID==0 {
   data-studio-unsaved
  }
  if latest.Status == RunRunning {
   data-builder-stream-url={ c.URL()+"/stream" } data-builder-run-id={ strconv.FormatInt(latest.ID,10) }
  } else if view.ActiveRun.Status == RunRunning {
   data-builder-stream-url={ view.ActiveChat.URL()+"/stream" } data-builder-run-id={ strconv.FormatInt(view.ActiveRun.ID,10) }
  }
 >
  <header class="piko-studio-heading">
   <div class="piko-studio-identity"><span class="piko-icon-tile piko-tone-lilac">@shell.Icon("chat-circle-dots")</span><div><h1><bdi dir="auto">{ c.Title }</bdi></h1><p class="piko-helper">
    if b.ID == 0 {
     { locale.T(ctx,"studio.general") }
    } else {
     <bdi dir="auto">{ b.Name }</bdi>
    }
   </p></div></div>
   <a class="piko-secondary-action piko-studio-new" href="/builder">@shell.Icon("plus")<span>{ locale.T(ctx,"piko.chat.start") }</span></a>
  </header>
  @studioSwitch()
  <div class="piko-studio-body">
   @chatSidebar(csrf,b,view.Chats,view.Bots,c.ID)
   <section id="studio-conversation" class="piko-studio-conversation" aria-label={ locale.T(ctx,"piko.chat.title") } tabindex="-1">
    <div id="studio-history" class="piko-studio-scroll" tabindex="0" aria-label={ locale.T(ctx,"builder.history") }>
     if len(history.Messages)==0 {
      if b.ID == 0 {
       @welcomeExamples()
      } else {
       <section class="piko-studio-welcome"><img src="/static/brand/piko-mark-v2.webp" width="56" height="56" alt=""/><h2>{ locale.T(ctx,"studio.bot.chat.empty.title") }</h2><p>{ locale.T(ctx,"builder.capabilities") }</p></section>
      }
     } else {
      <ol class="piko-builder-history">
       for _,message:=range history.Messages {
        if message.Role!=ResultRole || (message.Content!="builder.run.saved" && message.Content!="builder.run.undone") {
        <li class={ "piko-builder-message", "piko-builder-message-"+string(message.Role) }>
         @shell.MessageIdentity(locale.T(ctx,"builder.role."+string(message.Role)),message.Role==OwnerRole)
         <p class="piko-builder-text"><bdi dir="auto">
          if message.FeedbackKey()!="" {
           { locale.T(ctx,message.FeedbackKey()) }
          } else {
           { message.Content }
          }
         </bdi></p>
        </li>
        }
       }
      </ol>
     }
     @bot.ActionCards(csrf,b,history.Proposals)
     if latest.ID != 0 {
      <span hidden data-studio-outcome={ string(latest.Status) }></span>
     }
     if view.ActiveRun.Status == RunRunning && view.ActiveChat.ID != c.ID {
      <p class="piko-field-error" role="status" data-studio-busy>{ locale.T(ctx,"builder.busy") } <a id="studio-active-chat" class="piko-text-link" href={ templ.URL(view.ActiveChat.URL()) }><bdi dir="auto">{ view.ActiveChat.Title }</bdi></a></p>
      @connectionFeedback()
     }
     if latest.Status == RunRunning {
      <section class="piko-studio-progress" aria-label={ locale.T(ctx,"builder.stream.title") }>
       @shell.MessageIdentity(locale.T(ctx,"builder.role.model"),false)
       <p class="piko-chat-activity" role="status" aria-live="polite"><span class="piko-activity-spinner" aria-hidden="true"></span><span data-builder-progress>{ locale.T(ctx,"builder.progress.model") }</span></p>
       <p class="piko-builder-text"><bdi dir="auto" data-builder-reply></bdi></p>
       @connectionFeedback()
       <form method="post" data-studio-form="action" action={ c.URL()+"/runs/"+strconv.FormatInt(latest.ID,10)+"/stop" }><input type="hidden" name="csrf_token" value={ csrf }/><button id="studio-stop" type="submit" class="piko-secondary-action">{ locale.T(ctx,"builder.stop") }</button></form>
      </section>
     }
     <p class="piko-field-error" role="status" data-studio-refresh-error hidden>{ locale.T(ctx,"studio.refresh.error") } <button type="button" data-studio-refresh class="piko-text-link">{ locale.T(ctx,"builder.refresh") }</button></p>
 <div hidden data-admitted={ strconv.FormatInt(view.Allowance.Admitted,10) }>
 for _,run:=range history.Runs {
  <span data-run-id={ strconv.FormatInt(run.ID,10) } data-run-status={ string(run.Status) } data-run-result={ run.Result } data-before-revision={ strconv.FormatInt(run.BeforeRevision,10) }
   if run.AfterRevision.Valid {
    data-after-revision={ strconv.FormatInt(run.AfterRevision.Int64,10) }
   }
  ></span>
  @usage(run.Usage)
 }
 @usage(view.Allowance.Usage)
 </div>
 if view.Enabled && latest.CanRetry {
  <form class="piko-studio-retry" method="post" data-studio-form="action" action={ c.URL()+"/runs/"+strconv.FormatInt(latest.ID,10)+"/retry" }>
   <input type="hidden" name="csrf_token" value={ csrf }/>
   <button id={ "studio-retry-"+strconv.FormatInt(latest.ID,10) } class="piko-secondary-action" type="submit">{ locale.T(ctx,"builder.retry") }</button>
  </form>
 }

    </div>
    @composer(csrf,messageURL,view,latest.Status==RunRunning || view.ActiveRun.Status==RunRunning)
   </section>
   @studioPane(csrf,b,history,view)
  </div>
 </section>
}

templ studioSwitch() {
 <nav class="piko-studio-switch" aria-label={ locale.T(ctx,"studio.views") }>
  <button type="button" id="studio-view-conversation" data-studio-view="conversation" aria-controls="studio-conversation" aria-pressed="true">@shell.Icon("chat-circle-dots")<span>{ locale.T(ctx,"piko.chat.title") }</span></button>
  <button type="button" id="studio-view-pane" data-studio-view="pane" aria-controls="studio-pane" aria-pressed="false">@shell.Icon("telegram-logo")<span>{ locale.T(ctx,"preview.title") }</span></button>
 </nav>
}

templ chatSidebar(csrf string,b bot.Bot,chats []Chat,bots []bot.Bot,currentID int64) {
 <details open id="studio-chat-selector" class="piko-studio-sidebar">
  <summary id="studio-chat-picker">@shell.Icon("chat-circle-dots")<span>{ locale.T(ctx,"studio.chats") }</span>@shell.Icon("caret-left")</summary>
  <div class="piko-studio-sidebar-content">
   <a id="studio-new-chat" class="piko-studio-new piko-secondary-action" href="/builder">@shell.Icon("plus")<span>{ locale.T(ctx,"piko.chat.start") }</span></a>
   @savedChats(chats,currentID)
   if b.ID != 0 {
    <a id="studio-new-bot-chat" class="piko-secondary-action" href={ templ.URL(b.URL()+"/studio") }>{ locale.T(ctx,"studio.chat.new.bot") }</a>
   }
   @savedBots(bots)
  </div>
 </details>
}

templ savedChats(chats []Chat,currentID int64) {
 <nav id="saved-chats" class="piko-studio-saved" aria-label={ locale.T(ctx,"studio.chats") }>
  if len(chats)==0 {
   <p class="piko-helper">{ locale.T(ctx,"studio.chats.empty") }</p>
  }
  for _,c:=range chats {
   <a id={ "studio-chat-"+strconv.FormatInt(c.ID,10) } class="piko-saved-chat" href={ templ.URL(c.URL()) }
    if c.ID == currentID {
 aria-current="page"
 }
   ><div><bdi dir="auto">{ c.Title }</bdi><small>
    if c.BotID==0 {
     { locale.T(ctx,"studio.general") }
    } else {
     <bdi dir="auto">{ c.BotName }</bdi>
    }
   </small></div>@shell.Icon("caret-left")</a>
  }
 </nav>
}

templ studioPane(csrf string,b bot.Bot,history Conversation,view ChatView) {
 <aside id="studio-pane" class="piko-studio-pane" aria-labelledby="studio-pane-title" tabindex="-1">
  if b.ID==0 {
   <header class="piko-studio-pane-heading">@shell.Icon("telegram-logo")<h2 id="studio-pane-title">{ locale.T(ctx,"preview.title") }</h2></header>
   <div class="piko-studio-pane-content">@bot.PreviewEmpty(locale.T(ctx,"studio.preview.bot"),locale.T(ctx,"studio.preview.empty"))</div>
  } else {
   <h2 id="studio-pane-title" class="sr-only">{ locale.T(ctx,"preview.title") }</h2>
   <div class="piko-studio-pane-content"><p class="sr-only" data-draft-revision={ strconv.FormatInt(view.Revision,10) }>{ locale.T(ctx,"builder.revision")+" "+locale.Digits(strconv.FormatInt(view.Revision,10)) }</p>
    <nav class="piko-pane-tabs" aria-label={ locale.T(ctx,"studio.views") }><button id="studio-tab-preview" type="button" data-pane-tab="preview" aria-controls="studio-preview-panel" aria-pressed="true">{ locale.T(ctx,"preview.title") }</button><button id="studio-tab-changes" type="button" data-pane-tab="changes" aria-controls="studio-changes-panel" aria-pressed="false">{ locale.T(ctx,"changes.title") }</button></nav>
    <section id="studio-preview-panel" data-pane-panel="preview">@bot.PreviewPane(csrf,b,bot.Preview{},view.Revision>0,"")</section>
    @changesPane(csrf,b,history,view.Revision)
    <details id="studio-bot-tools" class="piko-studio-bot-tools"><summary>{ locale.T(ctx,"studio.bot.tools") }</summary>
    <a id="studio-draft" class="piko-secondary-action" href={ templ.URL(b.URL()+"/draft") }>@shell.Icon("squares-four")
 { locale.T(ctx,"draft.title") }</a>
    <a id="studio-overview" class="piko-text-link" href={ templ.URL(b.URL()) }>{ locale.T(ctx,"studio.bot.overview") }</a>
    @bot.DeployControls(csrf,b)
    </details>
   </div>
  }
 </aside>
}

// Accounting attributes support diagnostics without adding text to the conversation.
templ usage(u Usage) {
 <span hidden data-total-tokens={ u.TotalText() } data-cost={ u.CostText() } data-usage-complete={ strconv.FormatBool(u.Complete) }></span>
}

templ chatDocument(csrf string,b bot.Bot,history Conversation,view ChatView) {
 <script src="/static/studio.js?v=studio6" defer></script>
 <script src="/static/studio-preview.js?v=preview2" defer></script>
 <script src="/static/studio-panes.js?v=panes1" defer></script>
 <script src="/static/builder-status.js?v=studio3" defer></script>
 @chatContent(csrf,b,history,view)
}

templ savedBots(bots []bot.Bot) {
 if len(bots)>0 {
  <nav class="piko-studio-saved" aria-label={ locale.T(ctx,"workspace.bots") }><h2>{ locale.T(ctx,"workspace.bots") }</h2>
   for _,b:=range bots {
    <a id={ "studio-bot-"+strconv.FormatInt(b.ID,10) } class="piko-saved-chat" href={ templ.URL(b.URL()+"/studio") }><bdi dir="auto">{ b.Name }</bdi>@shell.Icon("caret-left")</a>
   }
  </nav>
 }
}

templ connectionFeedback() {
 <p class="piko-helper" data-builder-connection data-reconnecting={ locale.T(ctx,"builder.stream.reconnecting") } data-unavailable={ locale.T(ctx,"builder.stream.unavailable") }></p>
}

func selectionRevision(s Selection) string {
 if s.Key=="" { return "" }; return strconv.FormatInt(s.Revision,10)
}
