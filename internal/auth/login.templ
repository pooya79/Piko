package auth

import "buildx/internal/locale"
import forms "buildx/internal/web/form"

templ loginForm(csrf string, form AccountForm) {
    <div>
        <div class="mb-9">
            <p class="buildx-kicker text-primary">{ locale.T(ctx, "auth.login.kicker") }</p>
            <h1 class="buildx-page-title">{ locale.T(ctx, "auth.login.title") }</h1>
            <p class="buildx-page-copy">{ locale.T(ctx, "auth.login.subtitle") }</p>
        </div>
        @forms.FormAlert(form.Message)
        <form class="space-y-5" method="post" action="/login">
            <input type="hidden" name="csrf_token" value={ csrf }/>
            <fieldset class="fieldset p-0"><label class="buildx-label" for="email">{ locale.T(ctx, "auth.login.email") }</label><input id="email" value={ form.Email } class="buildx-input" required type="email" name="email" maxlength="254" autocomplete="email" dir="ltr" placeholder="you@example.com"/></fieldset>
            <fieldset class="fieldset p-0"><div class="flex items-center justify-between"><label class="buildx-label" for="password">{ locale.T(ctx, "auth.login.password") }</label><a class="buildx-text-link text-xs" href="/password/forgot">{ locale.T(ctx, "auth.login.forgot") }</a></div><input id="password" class="buildx-input" required type="password" name="password" maxlength="1024" autocomplete="current-password" placeholder={ locale.T(ctx, "auth.login.password.placeholder") }/></fieldset>
            <button class="btn btn-primary btn-block mt-3 gap-2">{ locale.T(ctx, "auth.login.submit") }<svg class="buildx-icon-sm buildx-directional-icon" aria-hidden="true"><use href="/static/icons.svg#arrow-right"></use></svg></button>
        </form>
        <p class="mt-8 border-t border-base-300 pt-6 text-center text-sm text-muted">{ locale.T(ctx, "auth.login.register.prompt") } <a class="buildx-text-link" href="/register">{ locale.T(ctx, "auth.login.register") }</a></p>
    </div>
}

templ LoginPage(csrf string, form AccountForm) { @authLayout(locale.T(ctx, "auth.login.submit"), csrf, loginForm(csrf, form)) }

