package auth

import "github.com/pooya79/Piko/internal/locale"
import forms "github.com/pooya79/Piko/internal/web/form"

templ registerForm(csrf string, form AccountForm) {
	<div>
		<div class="mb-8"><p class="piko-kicker text-primary">{ locale.T(ctx, "auth.register.kicker") }</p><h1 class="piko-page-title">{ locale.T(ctx, "auth.register.heading") }</h1><p class="piko-page-copy">{ locale.T(ctx, "auth.register.subtitle") }</p></div>
		@forms.FormAlert(form.Message)
		<form class="space-y-5" method="post" action="/register">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<fieldset class="fieldset p-0"><label class="piko-label" for="display-name">{ locale.T(ctx, "auth.register.name") }</label><input id="display-name" aria-invalid={ form.Invalid("display_name") } if form.Description("display_name", "display-name", "") != "" { aria-describedby={ form.Description("display_name", "display-name", "") } } value={ form.Name } class="piko-input" required name="display_name" dir="auto" maxlength="80" autocomplete="name" placeholder={ locale.T(ctx, "auth.register.name.placeholder") }/>@forms.FieldError("display-name", form.FieldErrors["display_name"])</fieldset>
			<fieldset class="fieldset p-0"><label class="piko-label" for="email">{ locale.T(ctx, "auth.login.email") }</label><input id="email" aria-invalid={ form.Invalid("email") } if form.Description("email", "email", "") != "" { aria-describedby={ form.Description("email", "email", "") } } value={ form.Email } class="piko-input" required type="email" name="email" maxlength="254" autocomplete="email" dir="ltr" placeholder="you@example.com"/>@forms.FieldError("email", form.FieldErrors["email"])</fieldset>
			<fieldset class="fieldset p-0"><label class="piko-label" for="password">{ locale.T(ctx, "auth.register.password") }</label><input id="password" aria-invalid={ form.Invalid("password") } if form.Description("password", "password", "password-hint") != "" { aria-describedby={ form.Description("password", "password", "password-hint") } } class="piko-input" required type="password" name="password" minlength="6" maxlength="1024" autocomplete="new-password" placeholder={ locale.T(ctx, "auth.register.password.placeholder") }/><p id="password-hint" class="piko-helper">{ locale.T(ctx, "auth.register.password.hint") }</p>@forms.FieldError("password", form.FieldErrors["password"])</fieldset>
			<button class="btn btn-primary btn-block mt-2 gap-2">{ locale.T(ctx, "auth.login.register") }<svg class="piko-icon-sm piko-directional-icon" aria-hidden="true"><use href="/static/icons.svg#arrow-right"></use></svg></button>
		</form>
		<p class="mt-8 text-center text-sm text-muted">{ locale.T(ctx, "auth.register.login.prompt") } <a class="link link-primary font-bold" href="/login">{ locale.T(ctx, "auth.login.submit") }</a></p>
	</div>
}

templ RegisterPage(csrf string, form AccountForm) { @authLayout(locale.T(ctx, "auth.register.page.title"), csrf, registerForm(csrf, form)) }
